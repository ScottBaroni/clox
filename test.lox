fun sum(a, b, c) {
  return a + b + c;
}
print 4 + sum(5, 6, 7);

fun noReturn() { }
print noReturn();

fun outer() {
  fun inner(x) { return x * 2; }
  return inner(21);
}
print outer();

print clock;

fun fib(n) {
  if (n < 2) return n;
  return fib(n - 2) + fib(n - 1);
}
var start = clock();
print fib(25);
print clock() - start;